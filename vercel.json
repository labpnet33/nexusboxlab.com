{
  "rewrites": [
    {
      "source": "/machines",
      "destination": "/independent-machines.html"
    },
    {
      "source": "/lab/__data.json",
      "destination": "/lab-capture/lab-data.json"
    },
    {
      "source": "/lab",
      "destination": "/lab-capture/lab.html"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/lab"
    }
  ],
  "redirects": [
    {
      "source": "/lab/",
      "destination": "/lab",
      "permanent": true
    }
  ]
}
